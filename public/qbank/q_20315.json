200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\npositive\tno organisms\tno growth"}, {"label": "D", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\nnegative\torganisms seen\tbacterial growth"}, {"label": "E", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\nnegative\tno organisms\tno growth"}], "correctAnswer": "C", "explanation": "<div class=\"relative w-full min-w-0 max-w-full self-stretch\" id=\"question-explanation\"><span class=\"\"><div id=\"div_t57259\" style=\"font-size: 1rem;\"><div class=\"group/triggerable\" data-is-open=\"false\"><div class=\"group/draggable\" data-is-draggable=\"true\" data-is-dragging=\"false\"><div class=\"group/resizable relative\" data-is-maximized=\"false\" data-is-resizable=\"true\" data-is-resizing=\"false\"><div class=\"relative max-w-full\"><div aria-hidden=\"true\" class=\"pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 transition-opacity duration-200 bg-gradient-to-r from-white dark:from-nbme-primary-dark-800 warm:from-egg-sour-50 to-transparent opacity-0\"></div><div aria-hidden=\"true\" class=\"pointer-events-none absolute right-0 top-0 bottom-0 w-8 z-10 transition-opacity duration-200 bg-gradient-to-l from-white dark:from-nbme-primary-dark-800 warm:from-egg-sour-50 to-transparent opacity-0\"></div><div class=\"max-w-full overflow-x-auto [&amp;_td]:min-w-[8rem] [&amp;_th]:min-w-[8rem]\"><table class=\"border bg-transparent dark:text-white border-black warm:border-brown-800 dark:border-white hover:bg-transparent warm:hover:bg-transparent dark:hover:bg-transparent cursor-default mt-2 mb-3\" style=\"font-size: 1rem;\"><tbody style=\"font-size: 1rem;\"><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"width: 40%; font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\"><mark class=\"bg-transparent dark:text-neutral-50\" data-markjs=\"true\" style=\"font-size: 1rem;\">G</mark>onococcal urethritis</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"width: 40%; font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Nongonococcal urethritis</strong></p></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"width: 20%; font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Organism</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\"><em style=\"font-size: 1rem;\">Neisseria gonorrhoeae </em></li></ul></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\"><em style=\"font-size: 1rem;\">Chlamydia trachomatis </em></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><em style=\"font-size: 1rem;\">Mycoplasma genitalium </em></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><em style=\"font-size: 1rem;\">Trichomonas vaginalis </em></li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Urethral fluid</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Purulent</li></ul></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Watery, scant</li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Gram stain</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Intracellular gram-negative diplococci</li></ul></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Aseptic with leukocytes</li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Treatment</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Ceftriaxone</li></ul></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Azithromycin or doxycycline</li></ul></td></tr></tbody></table></div></div></div></div></div></div><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">This patient has <strong style=\"font-size: 1rem;\">infectious urethritis</strong> and <strong style=\"font-size: 1rem;\">epididymitis</strong> due to <em style=\"font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Chlamydia trachomatis</strong></em>.\u00a0 <em style=\"font-size: 1rem;\">C trachomatis</em> urethral infections are often asymptomatic but patients may develop <strong style=\"font-size: 1rem;\">dysuria</strong> and scant, watery discharge; deeper spread to the epididymis is typically marked by <strong style=\"font-size: 1rem;\">scrotal pain</strong> with tenderness along the posterior aspect of the testis.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Laboratory results in patients with infectious urethritis due to <em style=\"font-size: 1rem;\">C trachomatis</em> are as follows:</p><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Pyuria</strong>:\u00a0 Urine dipstick testing will show positive leukocyte esterase, and urine Gram stain will reveal \u226510 white blood cells/hpf <strong style=\"font-size: 1rem;\">(Choice E)</strong>.</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Poor Gram staining</strong>:\u00a0 Gram stain of urethral swab can quickly diagnose <em style=\"font-size: 1rem;\">Neisseria gonorrhoeae</em> infection (intracellular gram-negative diplococci); however, <strong style=\"font-size: 1rem;\">organisms will not be seen</strong> in the setting of <em style=\"font-size: 1rem;\">C trachomatis</em> or <em style=\"font-size: 1rem;\">Mycoplasma genitalium</em> infection because these pathogens do not have sufficient peptidoglycan in their cell wall to pick up Gram stain.</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Negative urine culture</strong>:\u00a0 Because <em style=\"font-size: 1rem;\">C trachomatis</em> is an obligate intracellular pathogen, it cannot be grown on traditional culture medium; therefore, urine and genital swab cultures will be negative.</p></li></ul><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">The microbial diagnosis of <em style=\"font-size: 1rem;\">C trachomatis</em> infection is generally established with urine (or cervical) nucleic acid amplification testing.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice A)</strong>\u00a0 Positive urine white blood cell, Gram stain, and urine culture results are typical of a urinary tract infection caused by <em style=\"font-size: 1rem;\">Escherichia coli</em> or <em style=\"font-size: 1rem;\">Klebsiella pneumoniae</em>.\u00a0 However, obligate intracellular bacteria such as <em style=\"font-size: 1rem;\">C trachomatis</em> are not seen on Gram stain or easily cultured.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice B)</strong>\u00a0 Patients with <em style=\"font-size: 1rem;\">N gonorrhoeae</em> infection usually have pyuria, but have a negative urine culture because a specialized medium (eg, Thayer-Martin agar) is typically required to grow the organism.\u00a0 Gram stain of urethral discharge would show gram-negative intracellular diplococci.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice D)</strong>\u00a0 Positive urine Gram stain and culture with no pyuria may be seen in some patients with asymptomatic bacteriuria, a typically benign condition except in select situations (eg, pregnancy).</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Educational objective:</strong>Urinalysis in patients with <em style=\"font-size: 1rem;\">Chlamydia trachomatis</em> infection classically shows sterile pyuria (positive urine white blood cells, no bacteria on Gram stain, no growth on culture) because the <em style=\"font-size: 1rem;\">C trachomatis</em> bacterium is an obligate intracellular bacterium with minimal peptidoglycan in its cell wall.\u00a0 The diagnostic test of choice is nucleic acid amplification testing.\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c</p></span></div>", "educationalObjective": "Urinalysis in patients with Chlamydia trachomatis infection classically shows sterile pyuria (positive urine white blood cells, no bacteria on Gram stain, no growth on culture) because the C trachomatis bacterium is an obligate intracellular bacterium with minimal peptidoglycan in its cell wall.  The diagnostic test of choice is nucleic acid amplification testing.\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c", "subject": "Microbiology", "system": "Infectious Diseases", "topic": "Epididymitis", "category": "HIV and sexually transmitted infections", "peerCorrect": 73.0}