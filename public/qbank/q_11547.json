b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b"}], "correctAnswer": "H", "explanation": "<div class=\"relative w-full min-w-0 max-w-full self-stretch\" id=\"question-explanation\"><span class=\"\"><div id=\"div_t80980\" style=\"font-size: 1rem;\"><div class=\"group/triggerable\" data-is-open=\"false\"><div class=\"group/draggable\" data-is-draggable=\"true\" data-is-dragging=\"false\"><div class=\"group/resizable relative\" data-is-maximized=\"false\" data-is-resizable=\"true\" data-is-resizing=\"false\"><div class=\"relative max-w-full\"><div aria-hidden=\"true\" class=\"pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 transition-opacity duration-200 bg-gradient-to-r from-white dark:from-nbme-primary-dark-800 warm:from-egg-sour-50 to-transparent opacity-0\"></div><div aria-hidden=\"true\" class=\"pointer-events-none absolute right-0 top-0 bottom-0 w-8 z-10 transition-opacity duration-200 bg-gradient-to-l from-white dark:from-nbme-primary-dark-800 warm:from-egg-sour-50 to-transparent opacity-0\"></div><div class=\"max-w-full overflow-x-auto [&amp;_td]:min-w-[8rem] [&amp;_th]:min-w-[8rem]\"><table class=\"border bg-transparent dark:text-white border-black warm:border-brown-800 dark:border-white hover:bg-transparent warm:hover:bg-transparent dark:hover:bg-transparent cursor-default mt-2 mb-3\" style=\"font-size: 1rem;\"><tbody style=\"font-size: 1rem;\"><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" colspan=\"2\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\"><mark class=\"bg-transparent dark:text-neutral-50\" data-markjs=\"true\" style=\"font-size: 1rem;\">C</mark>ommon pathogens in bite infections*</strong></p></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Cat bite</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\"><em style=\"font-size: 1rem;\">Pasteurella multocida</em></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><em style=\"font-size: 1rem;\">Bartonella henselae</em></li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Dog bite</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\"><em style=\"font-size: 1rem;\">Pasteurella multocida</em> and <em style=\"font-size: 1rem;\">Pasteurella canis</em></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><em style=\"font-size: 1rem;\">Capnocytophaga canimorsus</em></li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Human bite</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\"><em style=\"font-size: 1rem;\">Eikenella corrodens</em></li><li class=\"mb-1\" style=\"font-size: 1rem;\">Group A <em style=\"font-size: 1rem;\">Streptococcus</em></li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" colspan=\"2\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">*Oral anaerobes (eg, <em style=\"font-size: 1rem;\">Fusobacterium</em>) &amp; human skin flora (eg,\u00a0<em style=\"font-size: 1rem;\">Staphylococcus</em>, <em style=\"font-size: 1rem;\">Streptococcus</em>) can be implicated with any bite.</p></td></tr></tbody></table></div></div></div></div></div></div><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">This patient with localized erythema, warmth, and tenderness has a skin and soft tissue infection at the site of a recent <strong style=\"font-size: 1rem;\">dog bite</strong>.\u00a0 Pathogens in animal bite wound infections include animal <strong style=\"font-size: 1rem;\">oral flora</strong> and/or human skin flora, and infections are often polymicrobial.\u00a0 One of the most frequently identified pathogens after a cat or dog bite is <em style=\"font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Pasteurella multocida</strong></em>; <em style=\"font-size: 1rem;\">Pasteurella <strong style=\"font-size: 1rem;\">canis</strong></em> is also common in dogs.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><em style=\"font-size: 1rem;\">Pasteurella</em> species are part of the normal upper respiratory tract flora in many healthy wild and domestic animals regardless of vaccine status.\u00a0 The bacteria are <strong style=\"font-size: 1rem;\">gram-negative</strong> coccobacilli with a <strong style=\"font-size: 1rem;\">mouse-like odor</strong> (due to indole positivity), as noted in this case.\u00a0 Other common pathogens in dog bite infections include human skin flora (eg, <em style=\"font-size: 1rem;\">Staphylococcus</em>, <em style=\"font-size: 1rem;\">Streptococcus</em>), anaerobes, and <em style=\"font-size: 1rem;\">Capnocytophaga canimorsus</em>.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Infection typically develops <strong style=\"font-size: 1rem;\">within 24 hours</strong> after inoculation and often presents as <strong style=\"font-size: 1rem;\">cellulitis</strong> (eg, erythema, warmth, tenderness).\u00a0 Management includes wound care and antibiotics (eg, amoxicillin-clavulanate).</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice A)</strong>\u00a0 Infection with <em style=\"font-size: 1rem;\">Bartonella henselae</em>, a gram-negative bacterium causing catscratch disease, typically causes a pustule/nodule with regional lymphadenopathy several days after inoculation.\u00a0 However, <em style=\"font-size: 1rem;\">B henselae</em> is transmitted via a scratch or bite from an infected cat (transmission from dogs is not common).</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice B)</strong>\u00a0 <em style=\"font-size: 1rem;\">Campylobacter jejuni</em> is usually transmitted via contaminated food and causes a diarrheal illness, not cellulitis.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice C)</strong>\u00a0 Skin infection with <em style=\"font-size: 1rem;\">Clostridium perfringens</em> (found in soil) usually occurs after penetrating trauma (eg, stab wound) and leads to myonecrosis and gas gangrene.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice D)</strong>\u00a0 Exposure to animals infected with <em style=\"font-size: 1rem;\">Coxiella burnetii</em> (eg, cattle, sheep) can cause Q fever resulting in a mild flu-like illness or pneumonia.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice E)</strong>\u00a0\u00a0<em style=\"font-size: 1rem;\">Erysipelothrix rhusiopathiae</em> is commonly found in domestic and marine animals and can cause a localized cutaneous infection (erysipeloid) typically following occupational exposure (eg, fishery, slaughterhouse).\u00a0 However, it is a gram-positive rod (not a gram-negative coccobacillus).</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice F)</strong>\u00a0 <em style=\"font-size: 1rem;\">Francisella tularensis</em> is a gram-negative bacterium that causes tularemia, a zoonotic infection that usually presents with regional lymphadenopathy and an ulcerative lesion at the inoculation site.\u00a0 This infection typically occurs following contact with animals such as rabbits and rodents, not dogs.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice G)</strong>\u00a0 <em style=\"font-size: 1rem;\">Fusobacterium</em> is an anaerobe that is part of normal oral flora and can be seen in soft tissue infections after a dog bite.\u00a0 However, infection with <em style=\"font-size: 1rem;\">Pasteurella</em> is more common, particularly in this patient whose cultures have a mouse-like odor.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice I)</strong>\u00a0 <em style=\"font-size: 1rem;\">Proteus mirabilis</em> is a common cause of urinary tract infections, not cellulitis.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Educational objective:</strong>Soft tissue infections following cat and dog bites are typically due to animal oral flora, the most common of which is <em style=\"font-size: 1rem;\">Pasteurella</em>.\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b</p></span></div>", "educationalObjective": "Soft tissue infections following cat and dog bites are typically due to animal oral flora, the most common of which is Pasteurella .\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b", "subject": "Microbiology", "system": "Infectious Diseases", "topic": "Animal and human bite injuries", "category": "Bacterial infections", "peerCorrect": 65.0}