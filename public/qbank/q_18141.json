0b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c"}, {"label": "D", "text": "Pseudomonas aeruginosa\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u20