\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b"}, {"label": "E", "text": "Streptococcus pneumoniae\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u20