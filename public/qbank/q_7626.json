u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\nDistal convoluted tubule\tSecretion of hydrogen ions"}, {"label": "D", "text": "\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\nProximal convoluted tubule\tGeneration of ammonia"}, {"label": "E", "text": "\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\nProximal convoluted tubule\tReabsorption of bicarbonate"}, {"label": "F", "text": "\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\nProximal convoluted tubule\tSecretion of hydrogen ions"}], "correctAnswer": "E", "explanation": "<div class=\"relative w-full min-w-0 max-w-full self-stretch\" id=\"question-explanation\"><span class=\"\"><div class=\"mb-4 text-start flex justify-start items-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><div class=\"group/triggerable\" data-is-open=\"false\"><div class=\"group/draggable\" data-is-draggable=\"true\" data-is-dragging=\"false\"><div class=\"group/resizable relative\" data-is-maximized=\"false\" data-is-resizable=\"true\" data-is-resizing=\"false\"><div class=\"w-full\"><button class=\"lg:max-w-lg md:max-w-md w-fit max-w-full my-5 hover:scale-[1.01] transition-[transform,_box-shadow] ease-in-out duration-500 hover:shadow-lg\"><img alt=\"\" class=\"max-w-full h-auto rounded-none\" src=\"../../Assets/images/g36lixocf8tvtfb6qu5de443.jpg\"/></button></div></div></div></div></div><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><mark class=\"bg-transparent dark:text-neutral-50\" data-markjs=\"true\" style=\"font-size: 1rem;\">T</mark>his patient's glycosuria with normal serum glucose in combination with normal anion gap metabolic acidosis, hypokalemia, and hypophosphatemia is highly suggestive of impaired proximal tubular reabsorption.\u00a0 The <strong style=\"font-size: 1rem;\">proximal convoluted tubule</strong> is responsible for reabsorption of bicarbonate in addition to amino acids, phosphate, glucose, water, and potassium.\u00a0 Impaired bicarbonate reabsorption can occur as an isolated defect (renal tubular acidosis [RTA] type 2) or as part of a more generalized proximal tubular dysfunction (<strong style=\"font-size: 1rem;\">Fanconi syndrome</strong>):</p><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Loss of bicarbonate</strong> causes persistent acidosis.</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Hypophosphatemia</strong> leads to <a class=\"hint\" data-exhibit-id=\"exhibit-yq0rdogh088b49wcozueggq8\" href=\"#exhibit-exhibit-yq0rdogh088b49wcozueggq8\">rickets</a> (eg, frontal bossing, leg bowing).</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Glucosuria</strong> contributes to polyuria (impaired renal concentrating ability also contributes).\u00a0 Serum glucose levels are normal, as seen here, because they are tightly regulated by multiple mechanisms (eg, insulin, glucagon) that are independent of renal reabsorption.</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Hypokalemia</strong> can lead to constipation and muscle weakness.</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Aminoaciduria, contributing to growth failure.</p></li></ul><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choices A and D)</strong>\u00a0 The proximal tubule is also responsible for the generation of ammonia (NH<sub style=\"font-size: 1rem;\">3</sub>).\u00a0 Hypoaldosteronism or aldosterone resistance (RTA type 4, most commonly seen in adults with diabetes) can disrupt this process by inhibiting production of NH<sub style=\"font-size: 1rem;\">3</sub> in the proximal tubule, resulting in reduced ammonium (NH<sub style=\"font-size: 1rem;\">4</sub><sup style=\"font-size: 1rem;\">+</sup>) excretion and metabolic acidosis.\u00a0 This patient's hypokalemia and hypophosphatemia are inconsistent with this diagnosis.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choices B, C, and F)</strong>\u00a0 Hydrogen ions (H<sup style=\"font-size: 1rem;\">+</sup>) are primarily secreted into the urine from the distal convoluted tubule.\u00a0 Failure of this process (RTA type 1) leads to decreased distal acid secretion and metabolic acidosis, but phosphate and glucose would be normal.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Educational objective:</strong>Defects in either the proximal or distal convoluted tubule (eg, bicarbonate loss, acid retention) can result in a normal anion gap metabolic acidosis.\u00a0 However, the proximal tubule is responsible for reabsorption of glucose, amino acids, and phosphate in addition to bicarbonate; therefore, generalized proximal tubular dysfunction (Fanconi syndrome) can also cause failure to thrive, glucosuria, and rickets.\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b</p></span></div>", "educationalObjective": "Defects in either the proximal or distal convoluted tubule (eg, bicarbonate loss, acid retention) can result in a normal anion gap metabolic acidosis.  However, the proximal tubule is responsible for reabsorption of glucose, amino acids, and phosphate in addition to bicarbonate; therefore, generalized proximal tubular dysfunction (Fanconi syndrome) can also cause failure to thrive, glucosuria, and rickets.\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b", "subject": "Pathophysiology", "system": "Renal, Urinary Systems & Electrolytes", "topic": "Renal tubular acidosis", "category": "Congenital and developmental anomalies", "peerCorrect": 66.0}