00c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c"}, {"label": "D", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c"}, {"label": "E", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c"}], "correctAnswer": "D", "explanation": "<div class=\"relative w-full min-w-0 max-w-full self-stretch\" id=\"question-explanation\"><span class=\"\"><div id=\"div_T39455\" style=\"font-size: 1rem;\"><div class=\"group/triggerable\" data-is-open=\"false\"><div class=\"group/draggable\" data-is-draggable=\"true\" data-is-dragging=\"false\"><div class=\"group/resizable relative\" data-is-maximized=\"false\" data-is-resizable=\"true\" data-is-resizing=\"false\"><div class=\"relative max-w-full\"><div aria-hidden=\"true\" class=\"pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 transition-opacity duration-200 bg-gradient-to-r from-white dark:from-nbme-primary-dark-800 warm:from-egg-sour-50 to-transparent opacity-0\"></div><div aria-hidden=\"true\" class=\"pointer-events-none absolute right-0 top-0 bottom-0 w-8 z-10 transition-opacity duration-200 bg-gradient-to-l from-white dark:from-nbme-primary-dark-800 warm:from-egg-sour-50 to-transparent opacity-0\"></div><div class=\"max-w-full overflow-x-auto [&amp;_td]:min-w-[8rem] [&amp;_th]:min-w-[8rem]\"><table class=\"border bg-transparent dark:text-white border-black warm:border-brown-800 dark:border-white hover:bg-transparent warm:hover:bg-transparent dark:hover:bg-transparent cursor-default mt-2 mb-3\" style=\"font-size: 1rem;\"><tbody style=\"font-size: 1rem;\"><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" colspan=\"2\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\"><mark class=\"bg-transparent dark:text-neutral-50\" data-markjs=\"true\" style=\"font-size: 1rem;\">A</mark>trial fibrillation</strong></p></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Pathogenesis</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Atrial remodeling due to:<ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"list-style-type: circle; font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Age-related myocardial changes</li><li class=\"mb-1\" style=\"font-size: 1rem;\">Atrial enlargement from heart disease (eg, HTN, MS)</li></ul></li><li class=\"mb-1\" style=\"font-size: 1rem;\">Foci of rapid electrical activity:<ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"list-style-type: circle; font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Commonly originate in pulmonary veins</li><li class=\"mb-1\" style=\"font-size: 1rem;\">Alcohol intake &amp; \u2191 sympathetic drive may contribute</li></ul></li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Clinicalpresentation</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Asymptomatic or palpitations \u00b1 dyspnea, fatigue</li><li class=\"mb-1\" style=\"font-size: 1rem;\">Irregularly irregular pulse</li><li class=\"mb-1\" style=\"font-size: 1rem;\">May present with thromboembolic event (eg, stroke)</li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Diagnosis</strong></p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">ECG shows variable R-R intervals &amp; no P waves</li><li class=\"mb-1\" style=\"font-size: 1rem;\">Continuous ECG often needed for paroxysmal disease</li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" colspan=\"2\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">HTN</strong> = hypertension; <strong style=\"font-size: 1rem;\">MS</strong> = mitral stenosis.</p></td></tr></tbody></table></div></div></div></div></div></div><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Palpitations are a subjective sensation of the heartbeat usually caused by rapid arrhythmia or forceful ventricular contraction.\u00a0 This patient with palpitations and an <strong style=\"font-size: 1rem;\">irregularly irregular</strong> pulse most likely has <strong style=\"font-size: 1rem;\">atrial fibrillation</strong>, the most common cause of an irregularly irregular rhythm.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">In atrial fibrillation, the atria experience rapid and chaotic electrical activity, and organized atrial depolarization is lost.\u00a0 In addition, because the rate of atrial electrical impulses is so high (eg, 500-600/min) and the atrioventricular node does not transmit impulses that quickly, impulses are transmitted to the ventricles randomly and intermittently.\u00a0 Therefore, <a class=\"hint\" data-exhibit-id=\"exhibit-avp81ljk7o7jyg8dhtl3nfll\" href=\"#exhibit-exhibit-avp81ljk7o7jyg8dhtl3nfll\">ECG</a> typically shows an <strong style=\"font-size: 1rem;\">absence of P waves</strong> and an irregularly irregular rhythm with <strong style=\"font-size: 1rem;\">varying R-R intervals</strong>; the ventricular rate is often (but not always) &gt;100/min.\u00a0 In addition, irregular, low-amplitude <strong style=\"font-size: 1rem;\">fibrillatory waves</strong> are sometimes present between the QRS complexes.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">The development of atrial fibrillation is encouraged by <strong style=\"font-size: 1rem;\">atrial remodeling</strong>, which involves changes to atrial conduction pathways that occur as a result of aging and underlying chronic disease (eg, hypertension, heart failure).\u00a0 Once a certain degree of remodeling is present, acute illness (eg, sepsis or other causes of increased sympathetic tone) and other conditions (eg, hyperthyroidism) can initiate foci of electrical activity that <strong style=\"font-size: 1rem;\">trigger</strong> the arrhythmia.\u00a0 Excessive <strong style=\"font-size: 1rem;\">alcohol consumption</strong> is also a common trigger (ie, \"holiday heart syndrome\").</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice A)</strong>\u00a0 <a class=\"hint\" data-exhibit-id=\"exhibit-ge97tnkesq78bx1z6i5pkv4i\" href=\"#exhibit-exhibit-ge97tnkesq78bx1z6i5pkv4i\">Ventricular bigeminy</a> involves a premature ventricular contraction after each normal sinus beat and is often triggered by periods of increased sympathetic tone.\u00a0 Palpitations are common, but the rhythm is regularly irregular (ie, R-R interval varies in a predictable manner), with 2 beats occurring close together followed by a relatively long pause before the next beat.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice B)</strong>\u00a0 <a class=\"hint\" data-exhibit-id=\"exhibit-pcgupb5x7195sjj8fp303mi4\" href=\"#exhibit-exhibit-pcgupb5x7195sjj8fp303mi4\">Ventricular tachycardia</a> demonstrates wide QRS complexes on ECG.\u00a0 It may cause palpitations, but the rhythm is regular.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice C)</strong>\u00a0 <a class=\"hint\" data-exhibit-id=\"exhibit-i42ceep9u1f41n4o0puir7ls\" href=\"#exhibit-exhibit-i42ceep9u1f41n4o0puir7ls\">Atrial flutter</a> demonstrates saw-toothed flutter waves on ECG and may cause palpitations.\u00a0 Because atrial activity is slower (eg, 300/min) and somewhat more organized than in atrial fibrillation, the rhythm can be regular or irregular, depending on the steadiness of conduction through the atrioventricular node.\u00a0 This ECG shows steady 2:1 conduction with a regular rhythm, which is not consistent with this patient's irregularly irregular pulse.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice E)</strong>\u00a0 <a class=\"hint\" data-exhibit-id=\"exhibit-wrcjit4yttfqr6tddu249tx0\" href=\"#exhibit-exhibit-wrcjit4yttfqr6tddu249tx0\">Atrioventricular nodal reentrant tachycardia</a> commonly causes palpitations, but the rhythm is regular.\u00a0 P waves are often not visible on ECG because they are buried within the QRS complexes.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Educational objective:</strong>Atrial fibrillation is the most common cause of an irregularly irregular rhythm.\u00a0 It often presents with palpitations and is confirmed by ECG showing an absence of organized P waves and irregularly irregular R-R intervals.\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c</p></span></div>", "educationalObjective": "Atrial fibrillation is the most common cause of an irregularly irregular rhythm.  It often presents with palpitations and is confirmed by ECG showing an absence of organized P waves and irregularly irregular R-R intervals.\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c", "subject": "Physiology", "system": "Cardiovascular Sy