\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\nIncreased\tDecreased\tIncreased"}, {"label": "D", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\nIncreased\tNo effect\tDecreased"}, {"label": "E", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\nNo effect\tIncreased\tDecreased"}], "correctAnswer": "D", "explanation": "<div class=\"relative w-full min-w-0 max-w-full self-stretch\" id=\"question-explanation\"><span class=\"\"><div class=\"mb-4 text-start flex justify-start items-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><div class=\"group/triggerable\" data-is-open=\"false\"><div class=\"group/draggable\" data-is-draggable=\"true\" data-is-dragging=\"false\"><div class=\"group/resizable relative\" data-is-maximized=\"false\" data-is-resizable=\"true\" data-is-resizing=\"false\"><div class=\"w-full\"><button class=\"lg:max-w-lg md:max-w-md w-fit max-w-full my-5 hover:scale-[1.01] transition-[transform,_box-shadow] ease-in-out duration-500 hover:shadow-lg\"><img alt=\"\" class=\"max-w-full h-auto rounded-none\" src=\"../../Assets/images/tvzaj50z4j00uv7x2k76r2cf.jpg\"/></button></div></div></div></div></div><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><mark class=\"bg-transparent dark:text-neutral-50\" data-markjs=\"true\" style=\"font-size: 1rem;\">T</mark>etrahydrofolate (THF) carries 1-carbon groups for the synthesis of purines, thymidine, and certain amino acids (eg, methionine).\u00a0 During thymidine synthesis, thymidylate synthase transfers a 1-carbon group from N<sup style=\"font-size: 1rem;\">5</sup>,N<sup style=\"font-size: 1rem;\">10</sup>-methylene-THF to deoxyuridine monophosphate (dUMP), forming deoxythymidine monophosphate (dTMP) and oxidizing the cofactor to dihydrofolate (DHF).\u00a0 DHF must then be reduced back to THF by <strong style=\"font-size: 1rem;\">dihydrofolate reductase (DHFR)</strong> before it can be reused.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Methotrexate is a folic acid analog that inhibits DHFR, depleting THF and thereby blocking both thymidine and purine synthesis.\u00a0 <strong style=\"font-size: 1rem;\">Leucovorin</strong> (folinic acid, N<sup style=\"font-size: 1rem;\">5</sup>-formyl-THF) is a reduced folate that is converted to active THF cofactors without requiring DHFR.\u00a0 Because it <strong style=\"font-size: 1rem;\">bypasses the step inhibited by methotrexate</strong>, leucovorin restores THF-dependent nucleotide synthesis and <strong style=\"font-size: 1rem;\">decreases methotrexate cytotoxicity</strong>.\u00a0 This is the basis of leucovorin rescue, which protects normal cells (eg, bone marrow, gastrointestinal mucosa) after high-dose methotrexate.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">5-Fluorouracil</strong> (5-FU) is a pyrimidine analog that is converted intracellularly to an active metabolite, 5-fluorodeoxyuridine monophosphate (FdUMP).\u00a0 FdUMP <strong style=\"font-size: 1rem;\">binds thymidylate synthase</strong> together with N<sup style=\"font-size: 1rem;\">5</sup>,N<sup style=\"font-size: 1rem;\">10</sup>-methylene-THF, forming a stable ternary complex that <strong style=\"font-size: 1rem;\">inactivates the enzyme</strong> and depletes thymidine.\u00a0 Thus, like methotrexate, 5-FU blocks thymidine synthesis, but at a different step.\u00a0 Because the inhibitory complex requires reduced folate, increasing intracellular N<sup style=\"font-size: 1rem;\">5</sup>,N<sup style=\"font-size: 1rem;\">10</sup>-methylene-THF with leucovorin stabilizes the complex and <strong style=\"font-size: 1rem;\">potentiates 5-FU cytotoxicity</strong>.\u00a0 For this reason, leucovorin is routinely given with 5-FU (eg, in colorectal cancer regimens).</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">6-Mercaptopurine</strong> (6-MP) is a purine analog that is activated by hypoxanthine-guanine phosphoribosyltransferase (HGPRT).\u00a0 Its metabolites inhibit the first committed step of de novo purine synthesis and are incorporated into DNA as thioguanine nucleotides.\u00a0 Because this block occurs upstream of the folate-dependent steps of purine synthesis, supplying reduced folate cannot bypass it, and leucovorin <strong style=\"font-size: 1rem;\">does not alter 6-MP cytotoxicity</strong>.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choices A, B, and E)</strong>\u00a0 Leucovorin rescue reverses cytotoxicity caused by depletion of reduced folate (eg, DHFR inhibition by methotrexate).\u00a0 5-FU instead inhibits thymidylate synthase in a reaction that requires reduced folate, so leucovorin increases its cytotoxicity rather than decreasing it or having no effect.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice C)</strong>\u00a0 Leucovorin decreases, rather than increases, methotrexate cytotoxicity because it supplies reduced folate downstream of the DHFR block.\u00a0 Leucovorin also has no effect on 6-MP, which blocks purine synthesis upstream of the folate-dependent steps.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Educational objective:</strong>Leucovorin (folinic acid) is a reduced folate that bypasses dihydrofolate reductase.\u00a0 It decreases methotrexate cytotoxicity (leucovorin rescue) but increases 5-fluorouracil cytotoxicity by enhancing its inhibition of thymidylate synthase.\u00a0 Leucovorin does not affect drugs that act independently of folate, such as 6-mercaptopurine.\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c</p></span></div>", "educationalObjective": "Leucovorin (folinic acid) is a reduced folate that bypasses dihydrofolate reductase.  It decreases methotrexate cytotoxicity (leucovorin rescue) but increases 5-fluorouracil cytotoxicity by enhancing its inhibition of thymidylate synthase.  Leucovorin does not affect drugs that act independently of folate, such as 6-mercaptopurine.\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c", "subject": "Pharmacology", "system": "Hematology & Oncology", "topic": "Chemotherapy", "category": "Principles of oncology", "peerCorrect": 51.0}