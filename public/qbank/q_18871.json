0c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\nNormal\t\u2191\tNormal\t\u2193"}, {"label": "D", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b