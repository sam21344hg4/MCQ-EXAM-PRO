c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\nProlonged\tProlonged\tNormal\tNormal"}, {"label": "F", "text": "\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\nProlonged\tProlonged\tProlonged\tProlonged"}], "correctAnswer": "B", "explanation": "<div class=\"relative w-full min-w-0 max-w-full self-stretch\" id=\"question-explanation\"><span class=\"\"><div class=\"mb-4 text-start flex justify-start items-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><div class=\"group/triggerable\" data-is-open=\"false\"><div class=\"group/draggable\" data-is-draggable=\"true\" data-is-dragging=\"false\"><div class=\"group/resizable relative\" data-is-maximized=\"false\" data-is-resizable=\"true\" data-is-resizing=\"false\"><div class=\"w-full\"><button class=\"lg:max-w-lg md:max-w-md w-fit max-w-full my-5 hover:scale-[1.01] transition-[transform,_box-shadow] ease-in-out duration-500 hover:shadow-lg\"><img alt=\"\" class=\"max-w-full h-auto rounded-none\" src=\"../../Assets/images/uq1qinw4z2lpu8p3uq7gjpva.png\"/></button></div></div></div></div></div><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><mark class=\"bg-transparent dark:text-neutral-50\" data-markjs=\"true\" style=\"font-size: 1rem;\">T</mark>his child has <strong style=\"font-size: 1rem;\">hemophilia A</strong>, an inherited bleeding disorder characterized by <strong style=\"font-size: 1rem;\">deficiency of factor VIII</strong>.\u00a0 Factor replacement therapy is typically administered prophylactically to patients with severe deficiency (ie, factor VIII level &lt;1%) and therapeutically for acute bleeding.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">A potential <strong style=\"font-size: 1rem;\">complication</strong> in patients who receive factor <strong style=\"font-size: 1rem;\">replacement therapy</strong> is the development of <strong style=\"font-size: 1rem;\">neutralizing antibodies</strong>, or inhibitors, due to immune system recognition of the infused factor as foreign.\u00a0 Patients often have <strong style=\"font-size: 1rem;\">breakthrough bleeding</strong> despite prophylactic therapy and do not improve with increased factor infusions, as seen in this child.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">In a patient with hemophilia A who is experiencing significant bleeding, a mixing study can help determine if an inhibitor is present.\u00a0 In this assay, the patient's plasma is combined with plasma from healthy patients (ie, containing normal levels of factor VIII), and coagulation times are compared:</p><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Factor VIII deficiency only (no inhibitor):\u00a0 Before mixing, PT is normal and PTT is prolonged because factor VIII is part of the <a class=\"hint\" data-exhibit-id=\"exhibit-rzuccb3jqf3lwrhla8uizmhk\" href=\"#exhibit-exhibit-rzuccb3jqf3lwrhla8uizmhk\">intrinsic pathway</a> of the coagulation cascade.\u00a0 After mixing, PTT normalizes due to the presence of factor VIII from the normal sample <strong style=\"font-size: 1rem;\">(Choice A)</strong>.</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Factor VIII deficiency with <strong style=\"font-size: 1rem;\">inhibitor</strong>:\u00a0 Before mixing, PT is normal and <strong style=\"font-size: 1rem;\">PTT is prolonged</strong>.\u00a0 However, PTT <strong style=\"font-size: 1rem;\">remains prolonged after mixing</strong> due to the presence of antibodies from the patient's plasma that neutralize factor VIII from the normal plasma.</p></li></ul><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Management of patients with hemophilia and inhibitors is challenging and may require a bypassing agent (eg, activated factor VII) for acute bleeding.\u00a0 Emicizumab, a monoclonal antibody that links factors IXa and X (mimicking the role of factor VIII), may also be considered for bleeding prophylaxis.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choices C, D, E, and F)</strong>\u00a0 Patients with prolonged PT and normal PTT at baseline typically have a factor deficiency involving only the extrinsic pathway of the coagulation cascade (eg, factor VII).\u00a0 Those with baseline elevations in both PT and PTT have a deficiency in the common pathway (eg, factor II, factor V).\u00a0 Because hemophilia A is characterized by deficiency within only the intrinsic pathway, patients have normal PT and prolonged PTT at baseline.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Educational objective:</strong>Patients with hemophilia A who receive factor VIII infusions are at risk for developing factor-neutralizing antibodies (inhibitors), which should be suspected when factor infusions do not effectively prevent or resolve bleeding.\u00a0 Evaluation reveals a baseline prolonged PTT that remains prolonged despite mixing with normal plasma; PT is normal.\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c</p></span></div>", "educationalObjective": "Patients with hemophilia A who receive factor VIII infusions are at risk for developing factor-neutralizing antibodies (inhibitors), which should be suspected when factor infusions do not effectively prevent or resolve bleeding.  Evaluation reveals a baseline prolonged PTT that remains prolonged despite mixing with normal plasma; PT is normal.\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c", "subject": "Pathophysiology", "system": "Hematology & Oncology", "topic": "Hemophilias", "category": "Hemostasis and thrombosis", "peerCorrect": 52.0}