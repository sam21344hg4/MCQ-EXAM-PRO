0b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\n\u2191\tNo change\t\u2191"}, {"label": "D", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200