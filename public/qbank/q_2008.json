\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\n\u2193\t\u2193\t\u2193"}, {"label": "D", "text": "\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u20