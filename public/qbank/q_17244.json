b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\nNormal\tNormal\t\u2191\tNormal"}, {"label": "C", "text": "\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\