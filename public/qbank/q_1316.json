b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c"}], "correctAnswer": "E", "explanation": "<div class=\"relative w-full min-w-0 max-w-full self-stretch\" id=\"question-explanation\"><span class=\"\"><div id=\"div_t39039\" style=\"font-size: 1rem;\"><div class=\"group/triggerable\" data-is-open=\"false\"><div class=\"group/draggable\" data-is-draggable=\"true\" data-is-dragging=\"false\"><div class=\"group/resizable relative\" data-is-maximized=\"false\" data-is-resizable=\"true\" data-is-resizing=\"false\"><div class=\"relative max-w-full\"><div aria-hidden=\"true\" class=\"pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 transition-opacity duration-200 bg-gradient-to-r from-white dark:from-nbme-primary-dark-800 warm:from-egg-sour-50 to-transparent opacity-0\"></div><div aria-hidden=\"true\" class=\"pointer-events-none absolute right-0 top-0 bottom-0 w-8 z-10 transition-opacity duration-200 bg-gradient-to-l from-white dark:from-nbme-primary-dark-800 warm:from-egg-sour-50 to-transparent opacity-0\"></div><div class=\"max-w-full overflow-x-auto [&amp;_td]:min-w-[8rem] [&amp;_th]:min-w-[8rem]\"><table class=\"border bg-transparent dark:text-white border-black warm:border-brown-800 dark:border-white hover:bg-transparent warm:hover:bg-transparent dark:hover:bg-transparent cursor-default mt-2 mb-3\" style=\"font-size: 1rem;\"><tbody style=\"font-size: 1rem;\"><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" colspan=\"2\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\"><mark class=\"bg-transparent dark:text-neutral-50\" data-markjs=\"true\" style=\"font-size: 1rem;\">S</mark>yphilis: diagnostic serology</strong></p></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Nontreponemal</strong>(RPR, VDRL)</p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Antibody to cardiolipin-cholesterol-lecithin antigen</li></ul><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Lower sensitivity in early infection</li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Treponemal</strong>(FTA-ABS, TP-EIA)</p></td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\"><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\">Antibody to treponemal antigens</li><li class=\"mb-1\" style=\"font-size: 1rem;\">Greater sensitivity in early infection</li></ul></td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" colspan=\"2\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">FTA-ABS</strong> = fluorescent treponemal antibody-absorption (test); <strong style=\"font-size: 1rem;\">RPR</strong> = rapid plasma reagin (test);\u00a0<strong style=\"font-size: 1rem;\">TP-EIA</strong> = <em style=\"font-size: 1rem;\">Treponema pallidum</em> enzyme immunoassay.</p></td></tr></tbody></table></div></div></div></div></div></div><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">This patient has fever, arthralgias, diffuse lymphadenopathy, elevated aminotransferases, and widespread maculopapular rash raising suspicion for <a class=\"hint\" data-exhibit-id=\"exhibit-i06o89aopltjulni1tj59zh5\" href=\"#exhibit-exhibit-i06o89aopltjulni1tj59zh5\">secondary syphilis</a>.\u00a0 Syphilis is a multistage infection caused by the spirochete <strong style=\"font-size: 1rem;\"><em style=\"font-size: 1rem;\">Treponema pallidum</em></strong>.\u00a0 Diagnostic screening and confirmation rely primarily on serologic testing.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Nontreponemal serologic tests</strong> (rapid plasma reagin, VDRL) mix a patient's serum with a cardiolipin-cholesterol-lecithin antigen.\u00a0 Aggregation or flocculation (clumping) indicates the presence of <strong style=\"font-size: 1rem;\">anticardiolipin antibodies</strong> in the patient's serum.\u00a0 These antibodies form in response to the release of lipids from cells damaged by <em style=\"font-size: 1rem;\">T pallidum</em>.\u00a0 However, anticardiolipin antibodies are <strong style=\"font-size: 1rem;\">nonspecific</strong>; they can also develop in other treponemal (eg, yaws, pinta, bejel) and nontreponemal (eg, tuberculosis) infections and certain rheumatologic diseases (eg, lupus), which can lead to false-positive results.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Positive nontreponemal screening requires diagnostic confirmation with <strong style=\"font-size: 1rem;\">treponemal serologic testing</strong> (eg, fluorescent treponemal antibody-absorption).\u00a0 Treponemal tests evaluate for <strong style=\"font-size: 1rem;\">antibodies that directly target <em style=\"font-size: 1rem;\">T pallidum</em></strong>; patient serum is mixed with killed <em style=\"font-size: 1rem;\">T pallidum</em> to evaluate for antibody adherence using immunofluorescence.\u00a0 Patients with positive nontreponemal and treponemal tests are considered infected with syphilis.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice A)</strong>\u00a0 Lyme disease is caused by the spirochete <em style=\"font-size: 1rem;\">Borrelia burgdorferi</em>.\u00a0 Patients with early Lyme disease often develop flulike symptoms and a bull's-eye rash (not a diffuse maculopapular rash).\u00a0 Serologic testing for IgM/IgG against <em style=\"font-size: 1rem;\">Borrelia</em> can aid in the diagnosis as the disease progresses.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice B)</strong>\u00a0 Rheumatoid factor is an antibody that targets the Fc portion of IgG.\u00a0 Elevations are often seen in patients with rheumatoid arthritis and other autoimmune diseases.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice C)</strong>\u00a0 <em style=\"font-size: 1rem;\">Histoplasma capsulatum</em> infection can be diagnosed by examining urine and serum for fungal antigens.\u00a0 <em style=\"font-size: 1rem;\">Histoplasma</em> infections usually present with prominent pulmonary manifestations rather than diffuse rash and lymphadenopathy.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">(Choice D)</strong>\u00a0 Antimitochondrial antibodies are present in &gt;95% of cases of primary biliary cholangitis, which usually causes fatigue, pruritus, hepatomegaly, and elevated alkaline phosphatase.\u00a0 This patient's systemic maculopapular rash and diffuse lymphadenopathy make syphilis more likely.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Educational objective:</strong>Syphilis is caused by the spirochete <em style=\"font-size: 1rem;\">Treponema pallidum</em>.\u00a0 Confirmation of the diagnosis requires 2 forms of serologic testing to prevent false-positive results.\u00a0 Nontreponemal tests (eg, rapid plasma reagin, VDRL) evaluate for anticardiolipin antibodies (nonspecific); treponemal tests evaluate for antibodies targeted against <em style=\"font-size: 1rem;\">T pallidum</em>.\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c</p></span></div>", "educationalObjective": "Syphilis is caused by the spirochete Treponema pallidum .  Confirmation of the diagnosis requires 2 forms of serologic testing to prevent false-positive results.  Nontreponemal tests (eg, rapid plasma reagin, VDRL) evaluate for anticardiolipin antibodies (nonspecific); treponemal tests evaluate for antibodies targeted against T pallidum .\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c", "subject": "Microbiology", "system": "Infectious Diseases", "topic": "Syphilis", "category": "HIV and sexually transmitted infections", "peerCorrect": 53.0}