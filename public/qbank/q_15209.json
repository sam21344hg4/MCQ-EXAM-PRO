00 dark:border-white p-1\" colspan=\"2\" style=\"font-size: 1rem;\">Urinalysis</td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\">\u00a0\u00a0\u00a0\u00a0Protein</td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\">negative</td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\">\u00a0\u00a0\u00a0\u00a0Red blood cells</td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\">0/hpf</td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\">\u00a0\u00a0\u00a0\u00a0White blood cells</td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\">0-1/hpf</td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\">\u00a0\u00a0\u00a0\u00a0Microscopy</td><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" style=\"font-size: 1rem;\">few hyaline casts</td></tr><tr class=\"hover:bg-original-nbme-400/10 warm:hover:bg-brown-700/10 dark:hover:bg-white/15\" style=\"font-size: 1rem;\"><td class=\"border border-collapse border-black warm:border-brown-800 dark:border-white p-1\" col