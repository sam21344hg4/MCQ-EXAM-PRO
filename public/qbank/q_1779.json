u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b"}, {"label": "D", "text": "Listeria monocytogenes\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\