c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\nIncreased\tIncreased\tDecreased"}, {"label": "D", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\nIncreased\tNormal\tDecreased"}, {"label": "E", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\nNormal\tIncreased\tNormal"}, {"label": "F", "text": "\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\nNormal\tNormal\tNormal"}], "correctAnswer": "D", "explanation": "<div class=\"relative w-full min-w-0 max-w-full self-stretch\" id=\"question-explanation\"><span class=\"\"><div class=\"mb-4 text-start flex justify-start items-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><div class=\"group/triggerable\" data-is-open=\"false\"><div class=\"group/draggable\" data-is-draggable=\"true\" data-is-dragging=\"false\"><div class=\"group/resizable relative\" data-is-maximized=\"false\" data-is-resizable=\"true\" data-is-resizing=\"false\"><div class=\"w-full\"><button class=\"lg:max-w-lg md:max-w-md w-fit max-w-full my-5 hover:scale-[1.01] transition-[transform,_box-shadow] ease-in-out duration-500 hover:shadow-lg\"><img alt=\"\" class=\"max-w-full h-auto rounded-none\" src=\"../../Assets/images/g36lixocf8tvtfb6qu5de443.jpg\"/></button></div></div></div></div></div><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><mark class=\"bg-transparent dark:text-neutral-50\" data-markjs=\"true\" style=\"font-size: 1rem;\">T</mark>his patient cannot reabsorb bicarbonate (HCO<sub style=\"font-size: 1rem;\">3</sub><sup style=\"font-size: 1rem;\">\u2212</sup>) in the <strong style=\"font-size: 1rem;\">proximal convoluted tubule</strong> (PCT), which is characteristic of type 2 renal tubular acidosis (RTA).\u00a0 <strong style=\"font-size: 1rem;\">Type 2 RTA</strong> commonly occurs as part of a generalized resorptive dysfunction affecting proximal tubular cells (ie, <strong style=\"font-size: 1rem;\">Fanconi syndrome</strong>).\u00a0 Patients presenting in infancy or childhood often have an underlying genetic condition (eg, cystinosis, galactosemia, Dent disease) that predisposes to tubular dysfunction.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">The PCT is normally responsible for <strong style=\"font-size: 1rem;\">reabsorbing HCO<sub style=\"font-size: 1rem;\">3</sub><sup style=\"font-size: 1rem;\">\u2212</sup></strong> as well as <strong style=\"font-size: 1rem;\">glucose</strong>, <strong style=\"font-size: 1rem;\">phosphate</strong>, <strong style=\"font-size: 1rem;\">potassium</strong>, water, and amino acids.\u00a0 The proximal tubule damage that occurs in Fanconi syndrome leads to loss of these substances in the urine, producing the following clinical effects:</p><ul class=\"flex flex-col justify-start items-start list-inside list-disc ml-4 mb-4\" style=\"font-size: 1rem;\"><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Inability to resorb HCO<sub style=\"font-size: 1rem;\">3</sub><sup style=\"font-size: 1rem;\">\u2212</sup> results in a normal anion gap <strong style=\"font-size: 1rem;\">metabolic acidosis</strong>.\u00a0 The resulting decrease in serum HCO<sub style=\"font-size: 1rem;\">3</sub><sup style=\"font-size: 1rem;\">\u2212</sup> is compensated by <strong style=\"font-size: 1rem;\">increased serum chloride</strong> (Cl<sup style=\"font-size: 1rem;\">\u2212</sup>):\u00a0 As HCO<sub style=\"font-size: 1rem;\">3</sub><sup style=\"font-size: 1rem;\">\u2212</sup>\u00a0is lost in the urine, the kidney retains Cl<sup style=\"font-size: 1rem;\">\u2212</sup>\u00a0(particularly in the intact distal portions of the nephron) to maintain electroneutrality. \u00a0Urine pH may initially be elevated during active HCO<sub style=\"font-size: 1rem;\">3</sub><sup style=\"font-size: 1rem;\">\u2212</sup> wasting but typically falls (&lt;5.5) once serum HCO<sub style=\"font-size: 1rem;\">3</sub><sup style=\"font-size: 1rem;\">\u2212</sup> drops below the reduced proximal reabsorptive threshold.</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Excessive tubular glucose impairs renal concentrating ability by acting as an osmotic diuretic, contributing to development of <strong style=\"font-size: 1rem;\">polyuria </strong>(eg, more wet diapers) and episodes of hypovolemia.\u00a0 However, plasma glucose is tightly regulated by mechanisms (eg, insulin, glucagon) independent of renal reabsorption.\u00a0 Therefore, serum <strong style=\"font-size: 1rem;\">glucose remains normal</strong>.</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Hypophosphatemia</strong> leads to <a class=\"hint\" data-exhibit-id=\"exhibit-sab96jwkvvdm6tlsxoasigsl\" href=\"#exhibit-exhibit-sab96jwkvvdm6tlsxoasigsl\">rickets</a> (eg, widening of wrist joints, frontal bossing, bowing of the legs).</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Hypokalemia</strong> can cause muscle weakness.</p></li><li class=\"mb-1\" style=\"font-size: 1rem;\"><p class=\"mb-4 text-start inline\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Loss of amino acids and low-molecular-weight proteins does not typically have a significant effect, but aminoaciduria can be a general marker of proximal tubular dysfunction.</p></li></ul><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\">Chronic acidosis, hypophosphatemia, and hypokalemia also contribute to <strong style=\"font-size: 1rem;\">growth failure</strong>, as seen in this patient.</p><p class=\"mb-4 text-start\" style=\"margin-bottom: 1rem; font-weight: 400; font-size: 1rem;\"><strong style=\"font-size: 1rem;\">Educational objective:</strong>The proximal convoluted tubule (PCT) is responsible for reabsorption of bicarbonate as well as glucose, phosphate, potassium, water, and amino acids.\u00a0 Generalized PCT dysfunction (eg, Fanconi syndrome) results in urinary loss of these substances; in addition, serum chloride rises to maintain electronegative balance from bicarbonate loss and serum glucose remains normal due to intact counterregulatory mechanisms.\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c</p></span></div>", "educationalObjective": "The proximal convoluted tubule (PCT) is responsible for reabsorption of bicarbonate as well as glucose, phosphate, potassium, water, and amino acids.  Generalized PCT dysfunction (eg, Fanconi syndrome) results in urinary loss of these substances; in addition, serum chloride rises to maintain electronegative balance from bicarbonate loss and serum glucose remains normal due to intact counterregulatory mechanisms.\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c", "subject": "Pathophysiology", "system": "Renal, Urinary Systems & Electrolytes", "topic": "Renal tubular acidosis", "category": "Fluid, electrolytes, and acid-base", "peerCorrect": 39.0}