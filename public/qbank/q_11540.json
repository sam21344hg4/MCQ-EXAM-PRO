200b\u200c\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b"}, {"label": "B", "text": "Dengue virus"}, {"label": "C", "text": "Haemophilus influenzae\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200c\u200b\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200b\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200b\u200b\u200c\u200b\u200c\u200b\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200c\u200c\u200b\u200b\u200c\u200c\u200c\u200c\u200c\u200c\u200b\u200c\u200c\u200b\u200c\u200b\u200c\u200b\u200b\u200b\u200b\u200b\u200c\u200c\u200c\u200b\u200b\u200b\u200c\u200b\u20